{
  "_comment": "Cloud Control Panel - Configuracion multi-cuenta con todas las features.",

  "settings": {
    "defaultRegion": "us-east-1",
    "pollIntervalSeconds": 30,
    "timezone": "America/Bogota"
  },

  "apiKeys": {
    "CHANGE_ME_superadmin_key": {
      "name": "Super Admin",
      "role": "superadmin",
      "accounts": ["*"]
    },
    "CHANGE_ME_admin_key": {
      "name": "Admin Equipo",
      "role": "admin",
      "accounts": ["*"]
    },
    "CHANGE_ME_operator_key": {
      "name": "Operador",
      "role": "operator",
      "accounts": ["cuenta-1"],
      "scheduler": {
        "view": true,
        "edit": false
      }
    }
  },

  "accounts": [
    {
      "id": "cuenta-1",
      "name": "PROD - Mi Proyecto",
      "awsAccountId": "111111111111",
      "region": "us-east-1",
      "crossAccountRoleArn": "arn:aws:iam::111111111111:role/CloudControlRemoteAccess",
      "features": {
        "scheduler": true,
        "notifications": true,
        "costEstimate": true
      },
      "schedule": {
        "timezone": "America/Bogota",
        "rules": [
          {
            "id": "rule-1",
            "instances": ["app-server", "db-server"],
            "startCron": "0 7 * * 1-5",
            "stopCron": "0 20 * * 1-5",
            "description": "L-V 7am a 8pm",
            "enabled": true
          }
        ]
      },
      "notifications": {
        "channels": [
          {
            "id": "ch-1",
            "type": "email",
            "name": "Admin Email",
            "config": {
              "to": "admin@empresa.com",
              "smtpHost": "smtp.gmail.com",
              "smtpPort": 587,
              "smtpUser": "alerts@empresa.com",
              "smtpPass": "CHANGE_ME_app_password"
            },
            "events": ["started", "stopped", "error", "scheduler_executed"],
            "enabled": true
          },
          {
            "id": "ch-2",
            "type": "telegram",
            "name": "Bot DevOps",
            "config": {
              "botToken": "CHANGE_ME_bot_token",
              "chatId": "CHANGE_ME_chat_id"
            },
            "events": ["started", "stopped", "scheduler_executed"],
            "enabled": false
          },
          {
            "id": "ch-3",
            "type": "teams",
            "name": "Canal Infra",
            "config": {
              "webhookUrl": "CHANGE_ME_webhook_url"
            },
            "events": ["error"],
            "enabled": false
          }
        ]
      },
      "instances": [
        {
          "id": "app-server",
          "name": "App Server",
          "instanceId": "i-0xxxxxxxxxxxxxxxxx",
          "description": "Servidor principal de aplicacion",
          "dashboardPort": 5476,
          "group": "core"
        },
        {
          "id": "db-server",
          "name": "Database Server",
          "instanceId": "i-0yyyyyyyyyyyyyyyyy",
          "description": "PostgreSQL",
          "dashboardPort": null,
          "group": "core"
        },
        {
          "id": "worker",
          "name": "Worker",
          "instanceId": "i-0zzzzzzzzzzzzzzzzz",
          "description": "Background jobs",
          "dashboardPort": null,
          "group": null
        }
      ],
      "groups": [
        {
          "id": "core",
          "name": "Core Servers",
          "description": "App + DB - se encienden/apagan juntas",
          "color": "#6366f1",
          "startOrder": ["db-server", "app-server"],
          "stopOrder": ["app-server", "db-server"]
        }
      ]
    },
    {
      "id": "cuenta-2",
      "name": "DEV - Staging",
      "awsAccountId": "222222222222",
      "region": "us-east-1",
      "crossAccountRoleArn": "arn:aws:iam::222222222222:role/CloudControlRemoteAccess",
      "features": {
        "scheduler": false,
        "notifications": false,
        "costEstimate": true
      },
      "instances": [
        {
          "id": "staging",
          "name": "Staging Server",
          "instanceId": "i-0aaaaaaaaaaaaaaaaa",
          "description": "Entorno de pruebas",
          "dashboardPort": 5476,
          "group": null
        }
      ],
      "groups": []
    }
  ]
}
