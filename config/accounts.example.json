{
  "_comment": "Cloud Control Panel - Configuracion de cuentas e instancias. Editado solo por admin.",

  "settings": {
    "defaultRegion": "us-east-1",
    "pollIntervalSeconds": 30,
    "timezone": "America/Bogota"
  },

  "apiKeys": {
    "CHANGE_ME_admin_key": {
      "name": "Admin Principal",
      "role": "admin",
      "accounts": ["*"]
    },
    "CHANGE_ME_operator_key": {
      "name": "Operador paridad",
      "role": "operator",
      "accounts": ["paridad"],
      "scheduler": {
        "view": true,
        "edit": false
      }
    }
  },

  "accounts": [
    {
      "id": "paridad",
      "name": "TEST - paridad",
      "awsAccountId": "111111111111",
      "region": "us-east-1",
      "crossAccountRoleArn": "arn:aws:iam::111111111111:role/CloudControlRemoteAccess",
      "features": {
        "scheduler": true,
        "notifications": true,
        "costEstimate": true
      },
      "notifications": {
        "channels": [
          {
            "id": "ch-1",
            "type": "email",
            "name": "Admin Email",
            "config": {
              "to": "admin@empresa.com",
              "smtpHost": "smtp.gmail.com",
              "smtpPort": 587,
              "smtpUser": "alerts@empresa.com"
            },
            "events": ["started", "stopped", "error"],
            "enabled": true
          }
        ]
      },
      "schedule": {
        "timezone": "America/Bogota",
        "rules": [
          {
            "id": "rule-1",
            "instances": ["par-app-server", "par-db-server"],
            "startCron": "0 7 * * 1-5",
            "stopCron": "0 20 * * 1-5",
            "description": "L-V 7am a 8pm",
            "enabled": true
          }
        ]
      },
      "instances": [
        {
          "id": "par-app-server",
          "name": "App Server",
          "instanceId": "i-0xxxxxxxxxxxxxxxxx",
          "instanceType": "t3.medium",
          "description": "Servidor principal de aplicacion",
          "dashboardPort": 5476,
          "group": "paridad-core"
        },
        {
          "id": "par-db-server",
          "name": "DB Server",
          "instanceId": "i-0yyyyyyyyyyyyyyyyy",
          "instanceType": "r5.large",
          "description": "Servidor de base de datos",
          "dashboardPort": null,
          "group": "paridad-core"
        }
      ],
      "groups": [
        {
          "id": "paridad-core",
          "name": "Core paridad",
          "description": "Infraestructura principal paridad (se encienden/apagan juntas)",
          "color": "#6366f1",
          "startOrder": ["par-db-server", "par-app-server"],
          "stopOrder": ["par-app-server", "par-db-server"]
        }
      ]
    },
    {
      "id": "SBG-10",
      "name": "PROD - SBG 10",
      "awsAccountId": "222222222222",
      "region": "us-east-1",
      "crossAccountRoleArn": "arn:aws:iam::222222222222:role/CloudControlRemoteAccess",
      "features": {
        "scheduler": false,
        "notifications": false,
        "costEstimate": true
      },
      "instances": [
        {
          "id": "SBG-main",
          "name": "Main Server",
          "instanceId": "i-0zzzzzzzzzzzzzzzzz",
          "instanceType": "t3.large",
          "description": "Servidor principal SBG",
          "dashboardPort": 5476,
          "group": null
        }
      ],
      "groups": []
    }
  ]
}
