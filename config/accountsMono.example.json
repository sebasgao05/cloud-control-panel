{
  "_comment": "Cloud Control Panel - Configuracion mono-cuenta (una sola cuenta AWS).",

  "settings": {
    "defaultRegion": "us-east-1",
    "pollIntervalSeconds": 30,
    "timezone": "America/Bogota"
  },

  "apiKeys": {
    "CHANGE_ME_superadmin_key": {
      "name": "Super Admin",
      "role": "superadmin",
      "accounts": ["*"]
    },
    "CHANGE_ME_operator_key": {
      "name": "Operador",
      "role": "operator",
      "accounts": ["principal"],
      "scheduler": {
        "view": true,
        "edit": false
      }
    }
  },

  "accounts": [
    {
      "id": "principal",
      "name": "Mi Cuenta AWS",
      "awsAccountId": "111111111111",
      "region": "us-east-1",
      "crossAccountRoleArn": null,
      "features": {
        "scheduler": true,
        "notifications": true,
        "costEstimate": true
      },
      "schedule": {
        "timezone": "America/Bogota",
        "rules": []
      },
      "notifications": {
        "channels": []
      },
      "instances": [
        {
          "id": "mi-server",
          "name": "Mi Servidor",
          "instanceId": "i-0xxxxxxxxxxxxxxxxx",
          "description": "Servidor principal",
          "dashboardPort": null,
          "group": null
        }
      ],
      "groups": []
    }
  ]
}
