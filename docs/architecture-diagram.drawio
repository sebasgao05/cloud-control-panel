                <!-- Legend -->
                <mxCell id="legend" value="━ Flujo sincrono  ╌ Flujo asincrono | 1→2→3→4: Request → EC2 | 5: Cross-account via STS | 6→7: Scheduler crea cron → EventBridge invoca Lambda | 8: Notifica Email/Telegram/Teams" style="text;html=0;align=left;fontSize=8;fillColor=#f5f5f5;strokeColor=#ccc;rounded=1;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
